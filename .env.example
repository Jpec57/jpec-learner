# Postgres
POSTGRES_USER=jpeclearner
POSTGRES_PASSWORD=jpeclearner
POSTGRES_DB=jpeclearner

# Backend
DATABASE_URL=postgresql+asyncpg://jpeclearner:jpeclearner@db:5432/jpeclearner
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
IMAGE_STORAGE_PATH=/data/images
CORS_ORIGINS=http://localhost:5173

# Self-hosted OCR (photo -> card/lesson text). OCR_SERVICE_URL points at the
# `ocr` compose service; the R2 vars are Cloudflare R2 credentials for the
# dedicated bucket that scanned source photos are uploaded to.
OCR_SERVICE_URL=http://ocr:8090
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jpeclearner-ocr-scans

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Web Push (Phase 7 scaffolding, not read by any code yet -- no scheduler sends
# notifications. Generate with: docker compose exec backend python scripts/generate_vapid_keys.py
# JPECLEARNER_VAPID_PUBLIC_KEY=
# JPECLEARNER_VAPID_PRIVATE_KEY=
